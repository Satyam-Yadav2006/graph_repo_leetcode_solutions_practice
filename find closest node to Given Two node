class Solution {
public:
    int n;
    void dfs(vector<int>& edges,vector<int>&dist,int node,vector<bool>&visited){
        visited[node]=true;
        int v=edges[node];
        if(v!=-1&&!visited[v]){
            visited[node]=true;
            dist[v]=1+dist[node];
            dfs(edges,dist,v,visited);
        }
    }
    int closestMeetingNode(vector<int>& edges, int node1, int node2) {
        n=edges.size();
        vector<int>dist1(n,INT_MAX);
        vector<int>dist2(n,INT_MAX);
        vector<bool>visited1(n,false);
        vector<bool>visited2(n,false);
        dist1[node1]=0;
        dist2[node2]=0;
        dfs(edges,dist1,node1,visited1);
        dfs(edges,dist2,node2,visited2);
        int minDistNode=-1;
        int min_Dist_till_now=INT_MAX;
        for(int i=0;i<n;i++){
            int maxD=max(dist1[i],dist2[i]);
            if(min_Dist_till_now>maxD){
                min_Dist_till_now=maxD;
                minDistNode=i;
            }
        }

       
    return minDistNode;
        
    }
};
