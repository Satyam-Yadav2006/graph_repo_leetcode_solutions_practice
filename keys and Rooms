class Solution {
public:
    void dfs(vector<vector<int>>& rooms,vector<bool>&visited,int S){
        visited[S]=true;
        for(auto & it:rooms[S]){
            if(!visited[it])
                dfs(rooms,visited,it);
        }
    }
    bool canVisitAllRooms(vector<vector<int>>& rooms) {
       int n=rooms.size();
       vector<bool>visited(n,false);
       dfs(rooms,visited,0);
       for(int i=0;i<n;i++){
        if(!visited[i])
            return false;
       }
        
       return true; 
    }
};
