class Solution {
public:
    bool dfs(unordered_map<int,vector<int>>&adj,int node,int parent,int &pathCount,vector<bool>& hasApple){
      bool foundApple=hasApple[node];
        for(int &v:adj[node]){
            if(v==parent)
                continue;
            if(dfs(adj,v,node,pathCount,hasApple)){
                pathCount+=2;
                foundApple=true;
            }

        }

       return foundApple;

    }
    int minTime(int n, vector<vector<int>>& edges, vector<bool>& hasApple) {
        unordered_map<int,vector<int>>adj;
        for(auto &vec:edges){
            int u=vec[0];
            int v=vec[1];
            adj[u].push_back(v);
            adj[v].push_back(u);
        }
        int pathCount=0;
        dfs(adj,0,-1,pathCount,hasApple);
        return pathCount;
    }
};
