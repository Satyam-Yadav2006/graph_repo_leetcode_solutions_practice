class Solution {
public:
    vector<int> findSmallestSetOfVertices(int n, vector<vector<int>>& edges) {
        vector<int>indegree(n,false);
        vector<int>result;
        for(auto &vec:edges){
            int u=vec[0];
            int v=vec[1];
            //u---->v
            indegree[v]=true;
        }
        for(int i=0;i<n;i++){
            if(indegree[i]==false){
                result.push_back(i);
            }
        }
        return result;
    }
};
